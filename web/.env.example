# ===== Cơ sở dữ liệu (PostgreSQL) =====
# Dùng được cho CẢ máy chủ nội bộ phòng khám LẪN đám mây.
# Ví dụ nội bộ:  postgresql://zenith:matkhau@127.0.0.1:5432/zenith_clinic?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zenith_clinic?schema=public"

# ===== Bảo mật =====
# Khoá ký phiên đăng nhập (JWT). Tạo mới:  openssl rand -base64 48
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"

# Khoá AES-256 mã hoá số điện thoại khách (32 byte, base64). Tạo mới:  openssl rand -base64 32
# ⚠️  Mất khoá này = không giải mã được số điện thoại đã lưu. Hãy sao lưu an toàn.
PHONE_ENC_KEY="thay-bang-32-byte-base64"

# ===== Tuỳ chọn =====
APP_NAME="Zenith Clinic"

# ===== AI soạn tin chăm sóc (TUỲ CHỌN — bỏ trống thì nút AI tự ẩn) =====
# TRUNG LẬP NHÀ CUNG CẤP: chọn 1 hãng bất kỳ, điền 3 biến dưới. Chỉ gửi tên khách
# + tên dịch vụ gần nhất cho AI (KHÔNG gửi số điện thoại / dữ liệu nhạy cảm).
# Gợi ý theo chi phí (rẻ → đắt), tham khảo giá tự kiểm chứng trước khi chốt:
#   DeepSeek : AI_BASE_URL=https://api.deepseek.com                                   AI_MODEL=deepseek-chat
#   Qwen     : AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1          AI_MODEL=qwen-plus
#   Gemini   : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai    AI_MODEL=gemini-2.0-flash
#   OpenAI   : AI_BASE_URL=https://api.openai.com/v1                                  AI_MODEL=gpt-4o-mini
#   Claude   : AI_BASE_URL=https://api.anthropic.com                                  AI_MODEL=claude-haiku-4-5
# LƯU Ý CHỦ QUYỀN DỮ LIỆU: app y tế — cân nhắc nơi đặt máy chủ của hãng (DeepSeek/Qwen
# xử lý ở Trung Quốc). Muốn dữ liệu không ra ngoài: tự host model (Ollama/vLLM) rồi
# trỏ AI_BASE_URL về máy nội bộ, vd http://127.0.0.1:11434/v1 — cùng chuẩn OpenAI.
# AI_API_KEY=""
# AI_BASE_URL=""
# AI_MODEL=""
# AI_PROVIDER=""   # tuỳ chọn: "openai" | "anthropic" (bỏ trống = tự suy ra từ AI_BASE_URL)

# ===== Kênh giao tiếp: Zalo OA + Facebook Messenger (TUỲ CHỌN) =====
# Chưa điền thì trang /cham-soc/hop-thu vẫn chạy nhưng không nhận/gửi được tin thật.
# Hướng dẫn chi tiết từng bước xem ngay trong app: /cham-soc/ket-noi (đăng nhập ADMIN).
#
# --- Zalo OA (BẮT BUỘC phải là Official Account đăng ký tại oa.zalo.me — Zalo cá
#     nhân KHÔNG có API chính thức, không dùng công cụ bẻ khoá Zalo cá nhân trên mạng) ---
# ZALO_APP_ID=""          # App ID tại developers.zalo.me
# ZALO_APP_SECRET=""      # Secret Key của app — dùng đổi/làm mới access token
# ZALO_OA_SECRET_KEY=""   # Secret Key riêng của OA (mục Webhook trong business.zalo.me) — dùng kiểm chữ ký tin đến
#
# --- Facebook Messenger (Fanpage) ---
# FB_APP_SECRET=""         # App Secret (Cài đặt > Cơ bản) — dùng kiểm chữ ký webhook
# FB_VERIFY_TOKEN=""       # Chuỗi tự đặt, khai TRÙNG khi đăng ký webhook trên Meta
# FB_APP_ID=""             # (tuỳ chọn) chỉ cần nếu dùng nút "Gia hạn token" tự động
# FB_GRAPH_API_VERSION=""  # (tuỳ chọn) mặc định "v21.0"
