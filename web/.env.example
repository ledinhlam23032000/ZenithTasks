# ===== Cơ sở dữ liệu (PostgreSQL) =====
# Dùng được cho CẢ máy chủ nội bộ phòng khám LẪN đám mây.
# Ví dụ nội bộ:  postgresql://zenith:matkhau@127.0.0.1:5432/zenith_clinic?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zenith_clinic?schema=public"

# ===== Bảo mật =====
# Khoá ký phiên đăng nhập (JWT). Tạo mới:  openssl rand -base64 48
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"

# Khoá AES-256 mã hoá số điện thoại khách (32 byte, base64). Tạo mới:  openssl rand -base64 32
# ⚠️  Mất khoá này = không giải mã được số điện thoại đã lưu. Hãy sao lưu an toàn.
PHONE_ENC_KEY="thay-bang-32-byte-base64"

# ===== Tuỳ chọn =====
APP_NAME="Zenith Clinic"
