// Zenith Clinic — Hệ thống quản lý Trung tâm Phẫu thuật Thẩm mỹ
// Thiết kế đáp ứng 7 yêu cầu nghiệp vụ: tiếp nhận/lịch hẹn, hồ sơ khách,
// tư vấn & thanh toán/công nợ, vật tư & ảnh trước-sau, chăm sóc khách hàng,
// báo cáo quản trị, và bảo mật số điện thoại (ẩn 100%, chỉ tra theo 5 số cuối).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================ ENUMS ============================

enum Role {
  ADMIN // Quản trị viên / Ban giám đốc — xem toàn bộ
  MANAGER // Quản lý — xem báo cáo, không sửa cấu hình hệ thống
  TELESALE // Tiếp nhận thông tin / Telesale — đặt lịch hẹn
  RECEPTION // Lễ tân — check-in, lập hồ sơ khách
  CONSULTANT // Tư vấn viên
  DOCTOR // Bác sĩ thực hiện dịch vụ
  NURSE // Điều dưỡng
  CARE // Chăm sóc khách hàng (CSKH)
  SHAREHOLDER // Cổ đông — chỉ XEM toàn bộ, không thao tác; không xem SĐT đầy đủ; không xem nhân sự
  COLLABORATOR // Cộng tác viên — chỉ xem khách/phụ trách và hoa hồng của mình
}

enum EmploymentStatus {
  ACTIVE
  RETIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CustomerSource {
  MARKETING // Marketing / quảng cáo
  COLLABORATOR // Cộng tác viên (CTV)
  WALK_IN // Khách vãng lai / tự đến
  REFERRAL // Khách cũ giới thiệu
  HOTLINE // Tổng đài / hotline
  FACEBOOK
  ZALO
  TIKTOK
  OTHER
}

// Trạng thái khách tham khảo (lead) — phễu trước khi thành khách.
enum LeadStatus {
  NEW // Mới (chưa liên hệ)
  CONTACTED // Đã liên hệ / đang tư vấn
  CONVERTED // Đã chuyển thành khách / đã đến
  LOST // Không quan tâm nữa
}

enum AppointmentType {
  NEW // Khách mới
  FOLLOW_UP // Tái khám
  RE_SERVICE // Làm lại / dịch vụ tiếp theo
}

enum AppointmentStatus {
  BOOKED // Đã đặt lịch
  CONFIRMED // Đã xác nhận
  ARRIVED // Khách đã đến (check-in)
  IN_CONSULT // Đang tư vấn
  IN_SERVICE // Đang làm dịch vụ
  DONE // Hoàn thành
  CANCELLED // Hủy
  NO_SHOW // Hẹn nhưng không đến
}

enum CaseStatus {
  OPEN // Mới mở hồ sơ
  CONSULTED // Đã tư vấn
  SERVICED // Đã/đang làm dịch vụ
  COMPLETED // Hoàn tất
  CANCELLED // Hủy
}

enum ConsultResult {
  PENDING // Chưa chốt
  AGREED // Chốt làm dịch vụ
  CONSIDERING // Khách cân nhắc
  DECLINED // Từ chối
}

enum PaymentMethod {
  CASH // Tiền mặt
  CARD // Quẹt thẻ
  TRANSFER // Chuyển khoản
  EWALLET // Ví điện tử
}

enum PhotoType {
  BEFORE // Ảnh trước làm
  AFTER // Ảnh sau làm
  FOLLOW_UP // Ảnh tái khám theo tháng/lần
  CLINICAL // Ảnh cận lâm sàng (X-quang, CT, siêu âm…)
}

enum CareChannel {
  NOTE // Ghi nhận nội bộ
  ZALO
  SMS
  CALL // Gọi điện
  EMAIL
  OTHER
}

enum CareDirection {
  IN
  OUT
}

enum ConversationStatus {
  OPEN
  IN_PROGRESS
  DONE
}

// Kênh nhắn tin 2 chiều thật (khác CareChannel — chỉ là nhật ký ghi tay).
enum ChannelKind {
  ZALO_OA // Zalo Official Account
  FACEBOOK // Facebook Messenger (Fanpage)
}

enum MessageStatus {
  RECEIVED // Tin đến từ khách (luôn thành công)
  SENT // Tin gửi đi, đã được nền tảng xác nhận nhận
  FAILED // Gửi thất bại (hết hạn token, ngoài khung giờ phản hồi, lỗi API…)
}

enum PlanTaskStatus {
  TODO // Chưa làm
  IN_PROGRESS // Đang làm
  DONE // Hoàn thành
}

enum AssistantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AssistantConversationStatus {
  OPEN
  ARCHIVED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AssistantWorkspaceKind {
  INTERNAL
  PROJECT
  GLOBAL
}

enum ZAiAgentKind {
  CHILD
  GLOBAL
}

enum ZAiAgentStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ZAiJobStatus {
  QUEUED
  PENDING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum ZAiJobDataAccess {
  METADATA_ONLY
  SCOPED_PROJECT_DATA
  APPROVED_RAW_TENANT_DATA
}

enum PaymentRequestType {
  EXPENSE
  SALARY
  COLLABORATOR
  STAFF_OTHER
}

enum PaymentRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum StaffAgreementType {
  CONFIDENTIALITY
  NON_COMPETE
}

enum StaffAgreementStatus {
  DRAFT
  SIGNED
  EXPIRED
  REVOKED
}

enum AssistantFeedbackKind {
  CORRECTION
  APPROVAL
  REJECTION
  NOTE
}

enum RevenueAllocationRole {
  CONSULTANT
  DOCTOR
  NURSE
  OTHER
}

// ============================ NHÂN SỰ ============================

model User {
  id                 String           @id @default(cuid())
  code               String?          @unique // Mã nhân viên
  fullName           String
  username           String           @unique
  passwordHash       String
  role               Role
  phone              String? // SĐT nội bộ của nhân viên (không phải khách)
  avatarUrl          String? // Ảnh đại diện (nhân viên tự cập nhật)
  // ----- Hồ sơ nhân sự (HR) — quản trị xem/sửa -----
  dob                DateTime? // Ngày sinh
  gender             Gender?
  address            String? // Địa chỉ
  hometown           String? // Quê quán
  nationalId         String? // CCCD / CMND
  bankAccount        String? // Số tài khoản
  bankName           String? // Ngân hàng
  bankHolder         String? // Chủ tài khoản
  emergencyName      String? // Người liên hệ khẩn cấp
  emergencyPhone     String? // SĐT khẩn cấp
  position           String? // Chức danh
  department         String? // Phòng / bộ phận
  hireDate           DateTime? // Ngày vào làm
  qualification      String? // Bằng cấp / chứng chỉ
  notes              String? // Ghi chú nội bộ
  // Quyền tuỳ chỉnh ngoài mặc định theo vai trò: { grant: string[], deny: string[] }
  permissions        Json?
  // Xác thực 2 lớp (TOTP). Mặc định tắt — không ảnh hưởng đăng nhập hiện tại.
  totpSecret         String?
  totpEnabled        Boolean          @default(false)
  mustChangePassword Boolean          @default(false)
  baseSalary         Decimal          @default(0) @db.Decimal(14, 0) // Lương cơ bản theo tháng
  active             Boolean          @default(true)
  employmentStatus   EmploymentStatus @default(ACTIVE)
  retiredAt          DateTime?
  retiredById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  customersCreated              Customer[]                 @relation("CustomerCreatedBy")
  appointmentsCreated           Appointment[]              @relation("ApptCreatedBy")
  appointmentsAssigned          Appointment[]              @relation("ApptConsultant")
  casesCreated                  CaseRecord[]               @relation("CaseCreatedBy")
  casesConsulted                CaseRecord[]               @relation("CaseConsultant")
  casesAsDoctor                 CaseRecord[]               @relation("CaseDoctor")
  caseServices                  CaseService[]              @relation("CaseServiceDoctor")
  caseServicesNursed            CaseService[]              @relation("CaseServiceNurse")
  payments                      Payment[]
  materialUsages                MaterialUsage[]
  photos                        Photo[]
  careMessages                  CareMessage[]
  followUpsCreated              FollowUp[]
  auditLogs                     AuditLog[]
  shifts                        Shift[]
  stockMovements                StockMovement[]
  attendances                   Attendance[]
  payrollEntries                PayrollEntry[]
  cashTransactions              CashTransaction[]
  consentsRecorded              CaseConsent[]
  debtPlans                     DebtPlan[]                 @relation("DebtPlanCreatedBy")
  leadsCreated                  Lead[]                     @relation("LeadCreatedBy")
  documentsUploaded             CaseDocument[]             @relation("DocUploadedBy")
  plansCreated                  Plan[]                     @relation("PlanCreatedBy")
  revenueAllocations            CaseRevenueAllocation[]
  periodsClosed                 AccountingPeriod[]
  channelAccounts               ChannelAccount[]
  channelMessagesSent           Message[]
  pushSubscriptions             PushSubscription[]
  assistantApprovals            AssistantApproval[]
  assistantConversations        AssistantConversation[]
  assistantMessages             AssistantMessage[]
  revenueAllocationsCreated     CaseRevenueAllocation[]    @relation("RevenueAllocationCreatedBy")
  assignedConversations         Conversation[]             @relation("ConversationAssignee")
  staffAgreements               StaffAgreement[]           @relation("StaffAgreementSubject")
  staffAgreementsCreated        StaffAgreement[]           @relation("StaffAgreementCreatedBy")
  paymentRequestsRequested      PaymentRequest[]           @relation("PaymentRequestRequester")
  paymentRequestsApproved       PaymentRequest[]           @relation("PaymentRequestApprover")
  paymentRequestsPayee          PaymentRequest[]           @relation("PaymentRequestPayee")
  consultationsCreated          ConsultationRecord[]       @relation("ConsultationCreatedBy")
  assistantFeedback             AssistantFeedback[]
  assistantFiles                AssistantFile[]
  aiAgentsCreated               ZAiAgent[]                 @relation("AiAgentCreator")
  aiJobsRequested               ZAiJob[]                   @relation("AiJobRequester")
  collaboratorProfile           Collaborator?
  collaboratorDocumentsUploaded CollaboratorDocument[]     @relation("CollaboratorDocumentUploadedBy")
  collaboratorPayoutRecordsPaid CollaboratorPayoutRecord[] @relation("CollaboratorPayoutRecordPaidBy")
  roleHistory                   StaffRoleHistory[]         @relation("StaffRoleSubject")
  roleChangesMade               StaffRoleHistory[]         @relation("StaffRoleChangedBy")
  workspaceTasksAssigned        ZWorkspaceTask[]            @relation("WorkspaceTaskAssignee")
  workspaceTasksCreated         ZWorkspaceTask[]            @relation("WorkspaceTaskCreator")
  workspaceCustomersCreated     ZWorkspaceCustomer[]        @relation("WorkspaceCustomerCreator")
  workspaceCustomersDeleted     ZWorkspaceCustomer[]        @relation("WorkspaceCustomerDeleter")
  workspaceAppointmentsCreated  ZWorkspaceAppointment[]     @relation("WorkspaceAppointmentCreator")
  workspaceAppointmentsAssigned ZWorkspaceAppointment[]     @relation("WorkspaceAppointmentAssignee")
  workspaceSalesCreated         ZWorkspaceSale[]            @relation("WorkspaceSaleCreator")
  workspaceLedgerEntriesCreated ZWorkspaceLedgerEntry[]      @relation("WorkspaceLedgerCreator")
  workspaceReconciliationsMatched ZWorkspacePaymentReconciliation[] @relation("WorkspaceReconciliationMatcher")
  workspacePayrollRunsCreated ZWorkspacePayrollRun[] @relation("WorkspacePayrollRunCreator")
  workspacePayrollRunsApproved ZWorkspacePayrollRun[] @relation("WorkspacePayrollRunApprover")
  workspacePayrollRunsSecondApproved ZWorkspacePayrollRun[] @relation("WorkspacePayrollRunSecondApprover")
  workspacePayrollRunsFinalized ZWorkspacePayrollRun[] @relation("WorkspacePayrollRunFinalizer")
  workspacePayrollRunsVoided ZWorkspacePayrollRun[] @relation("WorkspacePayrollRunVoider")
  workspacePayrollLines ZWorkspacePayrollLine[] @relation("WorkspacePayrollLineUser")
  workspaceConfigVersionsCreated ZWorkspaceConfigVersion[]   @relation("WorkspaceConfigCreatedBy")
  workspaceConfigVersionsApproved ZWorkspaceConfigVersion[]  @relation("WorkspaceConfigApprovedBy")
  workspaceConfigProposalsCreated ZWorkspaceConfigProposal[] @relation("WorkspaceProposalCreator")
  workspaceConfigProposalsApproved ZWorkspaceConfigProposal[] @relation("WorkspaceProposalApprover")
  workspaceConfigProposalsApplied ZWorkspaceConfigProposal[] @relation("WorkspaceProposalApplier")
}

// ============================ CHẤM CÔNG & LƯƠNG ============================

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date // ngày làm việc
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  note       String?

  @@unique([userId, date])
  @@index([date])
}

model PayrollEntry {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month              String // "YYYY-MM"
  commission         Decimal  @default(0) @db.Decimal(14, 0) // Giá trị cũ, giữ tương thích lịch sử
  commissionOverride Decimal? @db.Decimal(14, 0) // Điều chỉnh hoa hồng thủ công ngoài công thức thực thu
  bonus              Decimal  @default(0) @db.Decimal(14, 0) // Thưởng nóng
  adjustment         Decimal  @default(0) @db.Decimal(14, 0) // Điều chỉnh (+/-)
  nurseCases         Int      @default(0) // (không còn dùng — giữ để tương thích dữ liệu cũ)
  note               String?
  updatedAt          DateTime @updatedAt

  // ----- Kế toán: theo dõi đã CHI lương hay chưa -----
  // Khi bấm "Ghi sổ chi lương" ở trang Kế toán, hệ thống tạo 1 giao dịch CHI
  // (hạng mục SALARY) trong sổ thu chi rồi gắn vào đây. Xóa giao dịch đó ở sổ
  // thu chi sẽ tự bỏ đánh dấu (onDelete: SetNull) → không bao giờ lệch sổ.
  paidAmount       Decimal          @default(0) @db.Decimal(14, 0)
  paidAt           DateTime?
  cashTxId         String?          @unique
  cashTx           CashTransaction? @relation(fields: [cashTxId], references: [id], onDelete: SetNull)
  paymentRequestId String?          @unique
  paymentRequest   PaymentRequest?  @relation("PaymentRequestPayroll", fields: [paymentRequestId], references: [id], onDelete: SetNull)

  @@unique([userId, month])
}

// ============================ KHÁCH HÀNG ============================

model Customer {
  id                     String         @id @default(cuid())
  code                   String         @unique // Mã khách hàng, ví dụ KH000123
  fullName               String
  gender                 Gender?
  dob                    DateTime?
  // Số điện thoại được mã hoá AES-256-GCM, KHÔNG bao giờ trả về cho nhân viên.
  phoneEnc               String
  // 5 số cuối để tra cứu & hiển thị (theo yêu cầu số 7).
  phoneLast5             String
  // Băm SĐT đã chuẩn hoá để chống trùng hồ sơ.
  phoneHash              String
  // Token cổng khách hàng (link riêng để khách tự xem lịch sử/ảnh). Null = chưa bật.
  portalToken            String?        @unique
  // Hạn dùng của link cổng khách (D3 gđ2). Null = không hết hạn (link cũ trước khi có tính năng).
  portalTokenExpiresAt   DateTime?
  source                 CustomerSource @default(OTHER)
  sourceDetail           String? // Snapshot tên CTV / chiến dịch / nguồn cụ thể
  collaboratorId         String?
  collaborator           Collaborator?  @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  collaboratorAssignedAt DateTime?
  address                String?
  note                   String?
  // ----- An toàn y khoa (B6 giai đoạn 1) — bác sĩ xem trước khi làm dịch vụ -----
  allergies              String? // Dị ứng (thuốc/mỹ phẩm/thức ăn…)
  medicalHistory         String? // Tiền sử bệnh + thuốc đang dùng
  contraindications      String? // Chống chỉ định / lưu ý đặc biệt
  createdById            String?
  createdBy              User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  appointments  Appointment[]
  cases         CaseRecord[]
  photos        Photo[]
  careMessages  CareMessage[]
  followUps     FollowUp[]
  npsResponses  NpsResponse[]
  conversations Conversation[]

  @@index([phoneLast5])
  @@index([phoneHash])
  @@index([fullName])
}

// Đánh giá trải nghiệm của khách (NPS 0–10) — khách tự gửi từ cổng khách (D3 gđ2).
model NpsResponse {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  score      Int // 0..10
  comment    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

// ============================ KHÁCH THAM KHẢO (LEADS) ============================

// Khách từ nhiều nguồn giới thiệu tới THAM KHẢO dịch vụ nhưng CHƯA hẹn, CHƯA đến.
// Là phễu trước Customer/Appointment. Khi khách đồng ý → "chuyển thành khách" (CONVERTED).
model Lead {
  id              String         @id @default(cuid())
  fullName        String
  // SĐT (tuỳ chọn) — mã hoá như Customer để chuyển đổi liền mạch + bảo mật.
  phoneEnc        String?
  phoneLast5      String?
  phoneHash       String?
  source          CustomerSource @default(OTHER)
  sourceDetail    String? // Snapshot người giới thiệu / chiến dịch cụ thể
  collaboratorId  String?
  collaborator    Collaborator?  @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  serviceInterest String? // dịch vụ khách quan tâm
  note            String?
  status          LeadStatus     @default(NEW)
  createdById     String?
  createdBy       User?          @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([phoneLast5])
}

// ============================ LỊCH HẸN ============================

model Appointment {
  id              String            @id @default(cuid())
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  guestName       String? // Tên khách khi đặt lịch mà chưa lập hồ sơ
  // SĐT đầy đủ (mã hoá, tuỳ chọn) — CHỈ đặt lịch công khai điền (dat-lich/actions.ts) mới
  // có; tạo lịch nội bộ chỉ thu 5 số cuối (như trước) nên trường này null với lịch đó.
  phoneEnc        String?
  phoneLast5      String?
  type            AppointmentType   @default(NEW)
  status          AppointmentStatus @default(BOOKED)
  scheduledAt     DateTime
  serviceInterest String? // Dịch vụ khách quan tâm
  source          CustomerSource    @default(OTHER)
  sourceDetail    String?
  collaboratorId  String?
  collaborator    Collaborator?     @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  note            String?
  publicNonce     String?           @unique

  createdById  String?
  createdBy    User?       @relation("ApptCreatedBy", fields: [createdById], references: [id])
  consultantId String?
  consultant   User?       @relation("ApptConsultant", fields: [consultantId], references: [id])
  arrivedAt    DateTime?
  caseId       String?     @unique
  case         CaseRecord? @relation(fields: [caseId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

// ============================ DANH MỤC ============================

model Service {
  id           String            @id @default(cuid())
  name         String
  category     String?
  listPrice    Decimal           @default(0) @db.Decimal(14, 0) // Giá niêm yết (giá gốc)
  defaultPrice Decimal           @default(0) @db.Decimal(14, 0) // Giá ưu đãi (thực thu mặc định)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  caseServices CaseService[]
  // Định mức vật tư tiêu hao mặc định cho dịch vụ này (BOM) — B5 giai đoạn 2.
  materials    ServiceMaterial[]
}

model Material {
  id               String            @id @default(cuid())
  name             String
  unit             String            @default("cái")
  sku              String?
  minStock         Decimal           @default(0) @db.Decimal(12, 2) // Mức tồn tối thiểu (cảnh báo khi tồn ≤ mức này)
  lotNo            String? // Số lô của đợt nhập hiện tại
  expiryDate       DateTime? // Hạn dùng của đợt hiện tại
  active           Boolean           @default(true)
  stock            Decimal           @default(0) @db.Decimal(12, 2) // Tồn kho hiện tại
  avgCost          Decimal           @default(0) @db.Decimal(12, 2) // Giá vốn bình quân gia quyền (VND/đơn vị)
  createdAt        DateTime          @default(now())
  usages           MaterialUsage[]
  movements        StockMovement[]
  // Dịch vụ nào dùng vật tư này theo định mức (BOM) — B5 giai đoạn 2.
  serviceMaterials ServiceMaterial[]
}

// Định mức vật tư theo dịch vụ (BOM — Bill Of Materials) — B5 giai đoạn 2.
// Mỗi dòng = 1 dịch vụ tiêu hao mặc định `quantity` đơn vị của 1 vật tư cho MỖI lần làm.
// Khi thêm dịch vụ vào hồ sơ, nhân viên bấm "Trừ vật tư theo định mức" để hệ thống tự
// ghi nhận vật tư đã dùng (× số lượng dịch vụ) + trừ kho — tránh quên ghi vật tư.
model ServiceMaterial {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Decimal  @default(1) @db.Decimal(10, 2) // Định mức tiêu hao / 1 lần dịch vụ
  createdAt  DateTime @default(now())

  @@unique([serviceId, materialId])
  @@index([serviceId])
}

enum StockType {
  IN // Nhập kho
  OUT // Xuất kho (dùng cho ca)
  ADJUST // Điều chỉnh
}

model StockMovement {
  id          String    @id @default(cuid())
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type        StockType
  quantity    Decimal   @db.Decimal(12, 2)
  unitCost    Decimal?  @db.Decimal(12, 2) // Đơn giá tại thời điểm GD (nhập = giá mua; xuất = giá vốn bình quân)
  note        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([materialId])
  @@index([createdAt])
}

// ============================ HỒ SƠ ĐIỀU TRỊ ============================

model CaseRecord {
  id                     String        @id @default(cuid())
  code                   String        @unique // Mã hồ sơ, ví dụ HS000123
  customerId             String
  customer               Customer      @relation(fields: [customerId], references: [id])
  consultantId           String?
  consultant             User?         @relation("CaseConsultant", fields: [consultantId], references: [id])
  doctorId               String?
  doctor                 User?         @relation("CaseDoctor", fields: [doctorId], references: [id])
  status                 CaseStatus    @default(OPEN)
  consultResult          ConsultResult @default(PENDING) // Phục vụ tính tỉ lệ chốt tư vấn
  chiefComplaint         String? // Nhu cầu / lý do của khách
  note                   String?
  // Số tiền (VND, không phần lẻ). totalAmount = tổng finalPrice các dịch vụ.
  totalAmount            Decimal       @default(0) @db.Decimal(14, 0)
  discountAmount         Decimal       @default(0) @db.Decimal(14, 0)
  paidAmount             Decimal       @default(0) @db.Decimal(14, 0)
  debtAmount             Decimal       @default(0) @db.Decimal(14, 0) // = total - paid
  // Voucher giảm thêm trên tổng hồ sơ (giảm cả công nợ lẫn doanh thu tính hoa hồng).
  voucherCode            String?
  voucherAmount          Decimal       @default(0) @db.Decimal(14, 0)
  createdById            String?
  createdBy              User?         @relation("CaseCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  completedAt            DateTime?
  // Khóa hồ sơ: sau khi khóa, nhân viên không sửa được (chỉ quản trị mở lại).
  locked                 Boolean       @default(false)
  lockedAt               DateTime?
  lockedById             String?
  // Hoa hồng cộng tác viên giới thiệu khách (số tiền nhập tay).
  commissionAmount       Decimal       @default(0) @db.Decimal(14, 0)
  collaboratorId         String?
  collaborator           Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  collaboratorAssignedAt DateTime?

  services           CaseService[]
  payments           Payment[]
  materials          MaterialUsage[]
  photos             Photo[]
  followUps          FollowUp[]
  appointment        Appointment?
  consents           CaseConsent[]
  documents          CaseDocument[]
  debtPlan           DebtPlan?
  revenueAllocations CaseRevenueAllocation[]
  consultation       ConsultationRecord?
}

model CaseService {
  id          String     @id @default(cuid())
  caseId      String
  case        CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?   @relation(fields: [serviceId], references: [id])
  name        String // Tên dịch vụ tại thời điểm chốt (snapshot)
  listPrice   Decimal    @default(0) @db.Decimal(14, 0) // Giá gốc (niêm yết) tại thời điểm chốt
  unitPrice   Decimal    @default(0) @db.Decimal(14, 0) // Giá ưu đãi thực thu (đơn giá)
  quantity    Int        @default(1)
  discount    Decimal    @default(0) @db.Decimal(14, 0)
  finalPrice  Decimal    @default(0) @db.Decimal(14, 0)
  doctorId    String?
  doctor      User?      @relation("CaseServiceDoctor", fields: [doctorId], references: [id])
  // Điều dưỡng phụ trách dòng dịch vụ này (căn cứ tính "Tiền dịch vụ phụ" 100k/ca —
  // xem lib/commission.ts). Khác doctorId: KHÔNG tự sao chép từ CaseRecord lúc tạo,
  // phải chọn tay vì 1 hồ sơ không có "điều dưỡng phụ trách" mặc định như bác sĩ.
  nurseId     String?
  nurse       User?      @relation("CaseServiceNurse", fields: [nurseId], references: [id])
  performedAt DateTime?
  note        String?
  // Đã trừ vật tư theo định mức (BOM) cho dòng dịch vụ này chưa — tránh trừ kho 2 lần (B5 gđ2).
  bomApplied  Boolean    @default(false)
  createdAt   DateTime   @default(now())

  materialUsages MaterialUsage[]
}

model Payment {
  id           String        @id @default(cuid())
  clientNonce  String?       @unique
  caseId       String
  case         CaseRecord    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(14, 0)
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  receivedById String?
  receivedBy   User?         @relation(fields: [receivedById], references: [id])
  note         String?
}

model MaterialUsage {
  id            String       @id @default(cuid())
  caseId        String
  case          CaseRecord   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  materialId    String?
  material      Material?    @relation(fields: [materialId], references: [id])
  caseServiceId String?
  caseService   CaseService? @relation(fields: [caseServiceId], references: [id], onDelete: SetNull)
  name          String // Tên vật tư (snapshot)
  unit          String       @default("cái")
  quantity      Decimal      @default(1) @db.Decimal(10, 2)
  performedById String?
  performedBy   User?        @relation(fields: [performedById], references: [id])
  performedAt   DateTime     @default(now())
  note          String?
}

model Photo {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  caseId        String?
  case          CaseRecord? @relation(fields: [caseId], references: [id])
  type          PhotoType   @default(BEFORE)
  url           String // Đường dẫn ảnh đã lưu
  caption       String?
  followUpIndex Int? // Lần/tháng tái khám (1, 2, 3...)
  takenAt       DateTime    @default(now())
  uploadedById  String?
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id])
}

model FollowUp {
  id          String            @id @default(cuid())
  caseId      String
  case        CaseRecord        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(BOOKED)
  note        String?
  doneAt      DateTime?
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([scheduledAt])
}

// ============================ THÔNG BÁO ĐẨY ============================
// Mỗi thiết bị/trình duyệt đăng ký một endpoint Web Push. Endpoint lưu theo nhân viên,
// không lưu dữ liệu khách hàng hay nội dung tin nhắn.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================ CHĂM SÓC KHÁCH HÀNG ============================

model CareMessage {
  id          String        @id @default(cuid())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  caseId      String?
  channel     CareChannel   @default(NOTE)
  direction   CareDirection @default(OUT)
  content     String
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([createdAt])
}

// ============================ KÊNH GIAO TIẾP (OMNICHANNEL) ============================
// Hộp thư hợp nhất cho Zalo OA + Facebook Messenger — KHÁC với CareMessage (nhật ký ghi
// tay, gắn sẵn 1 Customer). Ở đây tin có thể đến TRƯỚC khi biết là khách nào (chưa liên
// kết hồ sơ) nên Conversation tách khỏi Customer (customerId nullable, liên kết thủ công
// hoặc — với Zalo — tự động nếu khách đồng ý chia sẻ SĐT qua webhook). Xem `lib/channels/`.

// 1 kết nối kênh (1 Zalo OA hoặc 1 Facebook Page) — token lưu MÃ HOÁ (xem lib/secret-crypto.ts).
model ChannelAccount {
  id              String      @id @default(cuid())
  kind            ChannelKind
  label           String // Tên hiển thị nội bộ, vd "Zalo OA phòng khám"
  externalId      String // oa_id (Zalo) hoặc Page ID (Facebook)
  externalName    String? // Tên OA/Page lấy từ API lúc kết nối (chỉ để hiển thị)
  accessTokenEnc  String // Mã hoá AES-256-GCM (PHONE_ENC_KEY)
  refreshTokenEnc String? // Chỉ Zalo OA có refresh_token
  tokenExpiresAt  DateTime? // Hạn access_token (Zalo ~1h — tự làm mới trước khi gửi tin)
  active          Boolean     @default(true)
  connectedById   String?
  connectedBy     User?       @relation(fields: [connectedById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  conversations Conversation[]

  @@unique([kind, externalId])
}

// 1 luồng hội thoại với 1 người dùng bên ngoài (1 Zalo user hoặc 1 Facebook PSID).
model Conversation {
  id                 String             @id @default(cuid())
  channelAccountId   String
  channelAccount     ChannelAccount     @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  kind               ChannelKind // Denormalize từ channelAccount — lọc/hiển thị nhanh không cần join
  externalUserId     String // Zalo: sender.id theo OA. Facebook: PSID theo Page.
  displayName        String? // Tên lấy từ hồ sơ Zalo/Facebook của người nhắn (best-effort)
  avatarUrl          String? // Ảnh đại diện (URL ngoài — KHÔNG tải về máy chủ)
  customerId         String?
  customer           Customer?          @relation(fields: [customerId], references: [id])
  lastMessageAt      DateTime           @default(now())
  lastMessagePreview String?
  lastDirection      CareDirection?
  unreadCount        Int                @default(0)
  status             ConversationStatus @default(OPEN)
  assignedToId       String?
  assignedTo         User?              @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  slaDueAt           DateTime?
  lastInboundAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  messages Message[]

  @@unique([channelAccountId, externalUserId])
  @@index([lastMessageAt])
  @@index([customerId])
  @@index([assignedToId, status])
  @@index([lastInboundAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      CareDirection
  status         MessageStatus @default(RECEIVED)
  text           String?
  attachments    Json? // [{ type: "image"|"file", url }] — tham chiếu URL ngoài của nền tảng
  externalId     String? // msg_id (Zalo) / mid (Facebook) — chống ghi trùng khi webhook gửi lại
  errorMessage   String? // Lý do gửi thất bại (hiển thị cho nhân viên)
  sentById       String? // Nhân viên bấm gửi (null = tin đến từ khách hoặc AI hệ thống)
  sentBy         User?         @relation(fields: [sentById], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([externalId]) // chống ghi trùng khi webhook gửi lại (xem lib/channels/conversations.ts)
  @@index([conversationId, createdAt])
}

// ============================ LỊCH LÀM VIỆC ============================

model Shift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  startTime String // "08:00"
  endTime   String // "17:00"
  note      String?
  createdAt DateTime @default(now())

  @@index([date])
}

// ============================ NHẬT KÝ HỆ THỐNG ============================

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  action   String // ví dụ: LOGIN, REVEAL_PHONE, CREATE_CASE...
  entity   String?
  entityId String?
  meta     Json?
  ip       String?
  at       DateTime @default(now())

  @@index([at])
}

model RateLimitBucket {
  key         String    @id
  count       Int       @default(0)
  firstAt     DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

// ============================ SỔ THU CHI (DÒNG TIỀN) ============================

enum CashType {
  INCOME // Thu
  EXPENSE // Chi
}

model CashTransaction {
  id          String        @id @default(cuid())
  type        CashType
  category    String // Mã hạng mục — xem web/src/lib/finance.ts
  amount      Decimal       @db.Decimal(14, 0)
  occurredAt  DateTime // Ngày phát sinh thực tế
  method      PaymentMethod @default(CASH)
  vendor      String? // Nhà cung cấp / nguồn / đối tác
  note        String?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  // Giao dịch này có phải do trang Kế toán sinh ra khi chi lương / hoa hồng không.
  payrollEntry     PayrollEntry?
  commissionPayout CommissionPayout?
  paymentRequestId String?           @unique
  paymentRequest   PaymentRequest?   @relation("PaymentRequestCashTransaction", fields: [paymentRequestId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([type])
}

// ============================ PHIẾU ĐỒNG Ý (CONSENT) — B6 gđ2 ============================

// Mẫu phiếu (đồng ý phẫu thuật, cam kết, mẫu hồ sơ y khoa…) — quản trị soạn sẵn nội dung.
model ConsentTemplate {
  id        String        @id @default(cuid())
  title     String // Tên phiếu, vd "Phiếu đồng ý phẫu thuật thẩm mỹ"
  body      String // Nội dung phiếu (văn bản). Có thể chứa {{tên}}, {{ngày}}, {{dịch vụ}}.
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  consents  CaseConsent[]
}

// Phiếu đồng ý đã ghi nhận cho một hồ sơ điều trị. Lưu SNAPSHOT nội dung tại thời điểm ký
// (mẫu có thể đổi sau). "Ký" ở đây là ghi nhận khách đã đồng ý/ký giấy — in ra cho khách ký tay.
model CaseConsent {
  id           String           @id @default(cuid())
  caseId       String
  case         CaseRecord       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId   String?
  template     ConsentTemplate? @relation(fields: [templateId], references: [id])
  title        String // snapshot tên phiếu
  body         String // snapshot nội dung
  signerName   String // người ký (khách hoặc người giám hộ)
  relationship String? // quan hệ với khách nếu người giám hộ ký (vd "Mẹ", "Vợ")
  signedAt     DateTime         @default(now())
  note         String?
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([caseId])
}

// Kế hoạch trả nợ (hẹn nợ) cho 1 hồ sơ công nợ — mỗi tháng vào "ngày X" trả "Y đồng"
// tới khi hết nợ. Mỗi hồ sơ chỉ có 1 kế hoạch (caseId unique). Tính lịch/trạng thái
// bằng hàm thuần `lib/debt-plan.ts`; KHÔNG sinh từng dòng kỳ (suy ra từ tham số).
model DebtPlan {
  id            String     @id @default(cuid())
  caseId        String     @unique
  case          CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  dayOfMonth    Int // ngày trả hàng tháng (1..28)
  monthlyAmount Decimal    @db.Decimal(14, 0) // số tiền trả mỗi tháng (VND)
  startDate     DateTime // mốc kỳ trả đầu tiên
  note          String?
  createdById   String?
  createdBy     User?      @relation("DebtPlanCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// Giấy tờ hành chính tải lên cho 1 hồ sơ (D - phiếu đồng ý đã ký, giấy tờ, PDF/ảnh/Word…).
// Thay cho việc gõ tay nội dung: nhân viên tải file đã soạn/đã ký lên rồi bấm "Xem".
model CaseDocument {
  id           String     @id @default(cuid())
  caseId       String
  case         CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title        String // tiêu đề giấy tờ (vd "Phiếu đồng ý phẫu thuật")
  fileName     String // tên tệp gốc để hiển thị
  url          String // đường dẫn phục vụ qua /media/<tệp>
  mime         String
  uploadedById String?
  uploadedBy   User?      @relation("DocUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([caseId])
}

// Tài liệu hồ sơ CTV: hợp đồng, cam kết, ảnh và các giấy tờ cần tra cứu.
model CollaboratorDocument {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  title          String
  fileName       String
  url            String
  mime           String
  uploadedById   String?
  uploadedBy     User?        @relation("CollaboratorDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([collaboratorId, createdAt])
}

// Lịch sử thực tế các khoản hoa hồng đã chuyển/chi cho CTV.
// amount là số tiền đã ghi nhận tại thời điểm chi, không tự tính lại từ hồ sơ.
model CollaboratorPayoutRecord {
  id               String          @id @default(cuid())
  collaboratorId   String
  collaborator     Collaborator    @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(14, 0)
  month            String
  note             String?
  paidAt           DateTime        @default(now())
  paidById         String?
  paidBy           User?           @relation("CollaboratorPayoutRecordPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paymentRequestId String?         @unique
  paymentRequest   PaymentRequest? @relation("PaymentRequestCollaboratorPayoutRecord", fields: [paymentRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([collaboratorId, paidAt])
  @@index([collaboratorId, month])
}

// Phân bổ doanh số nội bộ cho một hồ sơ giữa các nhân sự phối hợp.
// shareBps: phần trăm theo điểm cơ bản, 10000 = 100%; tổng phải đúng 10000 khi hồ sơ chốt.
model CaseRevenueAllocation {
  id          String                @id @default(cuid())
  caseId      String
  case        CaseRecord            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        RevenueAllocationRole
  shareBps    Int
  note        String?
  createdById String?
  createdBy   User?                 @relation("RevenueAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([caseId, userId, role])
  @@index([caseId])
  @@index([userId])
}

// Yêu cầu thao tác do Trợ lý AI lập — mutation phải chờ ADMIN xác nhận rõ ràng.
model AssistantConversation {
  id              String                      @id @default(cuid())
  userId          String
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  status          AssistantConversationStatus @default(OPEN)
  summary         String?                     @db.Text
  memory          Json?
  memoryVersion   Int                         @default(1)
  workspaceKind   AssistantWorkspaceKind      @default(INTERNAL)
  projectId       String?
  agentId         String?
  agent           ZAiAgent?                   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lastCompactedAt DateTime?
  lastMessageAt   DateTime                    @default(now())
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  messages        AssistantMessage[]
  approvals       AssistantApproval[]

  @@index([userId, status, lastMessageAt])
  @@index([userId, workspaceKind, projectId, status, lastMessageAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           AssistantMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model AssistantApproval {
  id             String                  @id @default(cuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AssistantConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolName       String
  arguments      Json
    preview         Json
  workspaceKind   AssistantWorkspaceKind   @default(INTERNAL)
  projectId       String?
  agentId         String?
  agent           ZAiAgent?                @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status          AssistantApprovalStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime                @default(now())
  resolvedAt     DateTime?

  @@index([userId, status])
  @@index([projectId, status])
  @@index([expiresAt])
}

// ============================ CHỨNG TỪ & HỒ SƠ BỔ SUNG ============================

model PaymentRequest {
  id                  String               @id @default(cuid())
  requestNo           String               @unique
  type                PaymentRequestType
  status              PaymentRequestStatus @default(DRAFT)
  requesterId         String
  requester           User                 @relation("PaymentRequestRequester", fields: [requesterId], references: [id])
  approverId          String?
  approver            User?                @relation("PaymentRequestApprover", fields: [approverId], references: [id])
  payeeUserId         String?
  payeeUser           User?                @relation("PaymentRequestPayee", fields: [payeeUserId], references: [id])
  payeeCollaboratorId String?
  payeeCollaborator   Collaborator?        @relation(fields: [payeeCollaboratorId], references: [id], onDelete: SetNull)
  payeeName           String
  amount              Decimal              @db.Decimal(14, 0)
  reason              String
  details             Json?
  month               String?
  requestedAt         DateTime             @default(now())
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  paidAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  payrollEntry             PayrollEntry?             @relation("PaymentRequestPayroll")
  commissionPayout         CommissionPayout?         @relation("PaymentRequestCommission")
  collaboratorPayoutRecord CollaboratorPayoutRecord? @relation("PaymentRequestCollaboratorPayoutRecord")
  cashTransaction          CashTransaction?          @relation("PaymentRequestCashTransaction")

  @@index([status, requestedAt])
  @@index([type, month])
}

model ConsultationRecord {
  id                 String     @id @default(cuid())
  caseId             String     @unique
  case               CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  weightKg           Decimal?   @db.Decimal(5, 2)
  heightCm           Decimal?   @db.Decimal(5, 2)
  bloodType          String?
  emergencyName      String?
  emergencyPhone     String?
  pulse              Int?
  bloodPressure      String?
  temperatureC       Decimal?   @db.Decimal(4, 1)
  respiratoryRate    Int?
  spo2               Int?
  screening          Json?
  patientConfirmed   Boolean    @default(false)
  patientConfirmedAt DateTime?
  wants              String?
  currentCondition   String?
  expectedResult     String?
  doctorIndication   String?
  serviceSnapshot    Json?
  // Nội dung đè riêng cho bản in; không thay đổi dữ liệu y khoa/hồ sơ nguồn.
  printOverrides     Json?
  createdById        String?
  createdBy          User?      @relation("ConsultationCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  finalizedAt        DateTime?
  finalizedById      String?

  @@index([createdAt])
}

model StaffAgreement {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation("StaffAgreementSubject", fields: [userId], references: [id], onDelete: Cascade)
  type            StaffAgreementType
  status          StaffAgreementStatus @default(DRAFT)
  title           String
  version         Int                  @default(1)
  contentSnapshot String
  signedAt        DateTime?
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  fileName        String?
  fileUrl         String?
  note            String?
  createdById     String?
  createdBy       User?                @relation("StaffAgreementCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([userId, type, version])
  @@index([userId, type, status])
}

model AssistantFile {
  id            String    @id @default(cuid())
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  originalName  String
  storedName    String
  mime          String
  sizeBytes     Int
  extractedText String?
  summary       String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?

  @@index([uploadedById, createdAt])
}

model AssistantFeedback {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            AssistantFeedbackKind
  prompt          String
  originalAnswer  String?
  correctedAnswer String?
  note            String?
  context         Json?
  createdAt       DateTime              @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

// Lập kế hoạch nội bộ dạng "task app" (Trợ Lý) — CHỈ ADMIN/MANAGER/SHAREHOLDER dùng được
// (xem lib/permissions.ts, mod:ke-hoach). Không có khái niệm giao việc cho nhân sự khác —
// nội bộ 3 vai trò quản trị/quản lý/cổ đông.
model Plan {
  id          String   @id @default(cuid())
  title       String
  note        String? // mô tả/ghi chú tổng quan của cả kế hoạch
  aiGenerated Boolean  @default(false) // true nếu tạo qua "Lập kế hoạch bằng AI" — hiện badge
  createdById String?
  createdBy   User?    @relation("PlanCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks PlanTask[]

  @@index([createdAt])
}

// Nhiệm vụ chính VÀ nhiệm vụ phụ dùng CHUNG 1 model, tự tham chiếu qua parentId:
// parentId null = nhiệm vụ chính; khác null = nhiệm vụ phụ. Schema KHÔNG tự giới hạn độ sâu —
// tầng server action chủ động chặn tạo nhiệm vụ phụ dưới 1 nhiệm vụ phụ khác (chỉ hỗ trợ 2 cấp).
model PlanTask {
  id        String         @id @default(cuid())
  planId    String
  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    PlanTask?      @relation("PlanSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  PlanTask[]     @relation("PlanSubtasks")
  title     String
  note      String? // ghi chú chi tiết (nhiệm vụ chính hay phụ đều dùng field này)
  status    PlanTaskStatus @default(TODO)
  order     Int            @default(0) // thứ tự thủ công TRONG CÙNG 1 cấp (cùng planId + cùng parentId)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([planId])
  @@index([parentId])
}

// Cấu hình đơn giản dạng khoá–giá trị, dùng chung toàn hệ thống (mọi máy thấy như nhau).
// Hiện dùng cho: ngưỡng cảnh báo công nợ ("debt.threshold"). Thêm cấu hình mới → thêm khoá.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================ KẾ TOÁN ============================

// Kỳ kế toán đã CHỐT SỔ. Có bản ghi cho tháng "YYYY-MM" = tháng đó đã khóa:
// không thêm/sửa/xóa giao dịch thu chi, không sửa lương, không ghi sổ chi lương
// của tháng đó nữa (Quản trị viên có thể mở lại). Các con số được CHỤP LẠI tại
// thời điểm chốt để báo cáo cũ không đổi theo dữ liệu phát sinh sau này.
model AccountingPeriod {
  id               String   @id @default(cuid())
  month            String   @unique // "YYYY-MM"
  serviceRevenue   Decimal  @default(0) @db.Decimal(14, 0) // Doanh thu dịch vụ (thực thu)
  otherIncome      Decimal  @default(0) @db.Decimal(14, 0) // Thu khác (sổ thu chi)
  operatingExpense Decimal  @default(0) @db.Decimal(14, 0) // Chi vận hành (KHÔNG gồm lương/hoa hồng)
  salaryExpense    Decimal  @default(0) @db.Decimal(14, 0) // Chi lương nhân viên (bảng lương)
  ctvCommission    Decimal  @default(0) @db.Decimal(14, 0) // Hoa hồng cộng tác viên
  profit           Decimal  @default(0) @db.Decimal(14, 0) // Lãi/Lỗ
  note             String?
  closedAt         DateTime @default(now())
  closedById       String?
  closedBy         User?    @relation(fields: [closedById], references: [id])

  @@index([month])
}

// Chi hoa hồng cộng tác viên theo tháng (mỗi CTV 1 lần/tháng). Số tiền phải trả
// được cộng từ CaseRecord.commissionAmount của khách do CTV đó giới thiệu.
model CommissionPayout {
  id               String           @id @default(cuid())
  collaboratorId   String?
  collaborator     Collaborator?    @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  name             String // Snapshot tên CTV tại thời điểm chi trả
  month            String // "YYYY-MM"
  amount           Decimal          @db.Decimal(14, 0)
  paidAt           DateTime         @default(now())
  cashTxId         String?          @unique
  cashTx           CashTransaction? @relation(fields: [cashTxId], references: [id], onDelete: SetNull)
  paymentRequestId String?          @unique
  paymentRequest   PaymentRequest?  @relation("PaymentRequestCommission", fields: [paymentRequestId], references: [id], onDelete: SetNull)

  @@unique([name, month])
  @@unique([collaboratorId, month])
  @@index([month])
}

// Hồ sơ Cộng tác viên (đối tác giới thiệu khách). Tên chỉ là thông tin hiển thị;
// liên kết nghiệp vụ mới dùng collaboratorId.
model Collaborator {
  id          String    @id @default(cuid())
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String    @unique // tên hiển thị hiện tại
  phone       String?
  bankAccount String?
  bankName    String?
  bankHolder  String?
  note        String?
  active      Boolean   @default(true)
  suspendedAt DateTime?
  archivedAt  DateTime?
  statusNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customers       Customer[]
  leads           Lead[]
  appointments    Appointment[]
  cases           CaseRecord[]
  payouts         CommissionPayout[]
  paymentRequests PaymentRequest[]
  documents       CollaboratorDocument[]
  payoutRecords   CollaboratorPayoutRecord[]
}

model StaffRoleHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("StaffRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  fromRole       Role
  toRole         Role
  fromPosition   String?
  toPosition     String?
  fromDepartment String?
  toDepartment   String?
  note           String?
  changedById    String?
  changedBy      User?    @relation("StaffRoleChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt      DateTime @default(now())

  @@index([userId, changedAt])
}

// ============================ ZENITH OPERATING FRAMEWORK V2 ============================

enum ZProjectType {
  INTERNAL_CLINIC
  DISTRIBUTION
  PARTNERSHIP
  SERVICE
  OTHER
}

enum ZProjectStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ZWorkspaceConfigKind {
  MODULES
  LAYOUT
  SETTINGS
  ROLES
}

enum ZWorkspaceConfigStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ROLLED_BACK
}

enum ZMemberPreset {
  PROJECT_ADMIN
  FINANCE
  INVENTORY
  SALES
  VIEWER
  CUSTOM
}

enum ZUnitType {
  DEPARTMENT
  TEAM
  FUNCTION
}

enum ZAssignmentStatus {
  ACTIVE
  ENDED
}

enum ZWorkspaceTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ZWorkspaceSaleStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum ZWorkspaceLedgerDirection {
  INCOME
  EXPENSE
}

enum ZWorkspaceLedgerStatus {
  POSTED
  VOIDED
}

enum ZWorkspaceReconciliationStatus {
  UNMATCHED
  MATCHED
  EXCEPTION
}

enum ZWorkspacePayrollRunStatus {
  DRAFT
  PREVIEW
  APPROVED
  FINALIZED
  VOIDED
}

enum ZWorkspacePayrollLineStatus {
  CALCULATED
  APPROVED
  PAID
  VOIDED
}

enum ZMechanismKind {
  COMMISSION
  DISCOUNT
  REVENUE_SHARE
  BONUS
  RANK
  OTHER
}

enum ZMechanismStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  RETIRED
  SUPERSEDED
}

enum ZWorkspaceProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  APPLIED
  REJECTED
  EXPIRED
}

model ZProject {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  name                String
  description         String?
  projectType         ZProjectType           @default(OTHER)
  status              ZProjectStatus         @default(DRAFT)
  ownerUserId         String?
  currency            String                 @default("VND")
  enabledFeatures     Json?
  settings            Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
    members             ZProjectMember[]
  aiAgents            ZAiAgent[]
  aiJobs              ZAiJob[]
  units                ZOrganizationUnit[]
  positions           ZProjectPosition[]
  mechanisms          ZMechanismDefinition[]
  zprojectAssignments ZProjectAssignment[]
  workspaceTasks      ZWorkspaceTask[]
  workspaceCustomers  ZWorkspaceCustomer[]
  workspaceAppointments ZWorkspaceAppointment[]
  workspaceSales      ZWorkspaceSale[]
  workspaceLedgerEntries ZWorkspaceLedgerEntry[]
  workspaceReconciliations ZWorkspacePaymentReconciliation[]
  payrollRuns         ZWorkspacePayrollRun[]
  payrollLines        ZWorkspacePayrollLine[]
  configVersions      ZWorkspaceConfigVersion[]
  configProposals     ZWorkspaceConfigProposal[]

  @@index([status, createdAt])
}

model ZAiJob {
  id                  String                 @id @default(cuid())
  idempotencyKey      String                 @unique
  requestedById       String
  sourceWorkspaceKind AssistantWorkspaceKind
  sourceProjectId     String?
  conversationId      String?
  messageId           String?
  targetAgentId       String
  targetProjectId     String?
  toolName            String
  action              String
  arguments           Json
  dataAccess          ZAiJobDataAccess
  requiresRuntimeReauthorization Boolean     @default(true)
  approvalId          String?
  resultMeta          Json?
  failureMeta         Json?
  status              ZAiJobStatus           @default(QUEUED)
  attempt             Int                    @default(0)
  maxAttempts         Int
  timeoutMs           Int
  startedAt           DateTime?
  finishedAt          DateTime?
  lastError           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  requestedBy         User                   @relation("AiJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  targetAgent         ZAiAgent               @relation(fields: [targetAgentId], references: [id], onDelete: Restrict)
  targetProject       ZProject?              @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetAgentId, status, createdAt])
  @@index([targetProjectId, status, createdAt])
  @@index([status, createdAt])
}

model ZAiAgent {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  kind            ZAiAgentKind
  status          ZAiAgentStatus @default(DRAFT)
  projectId       String?
  project         ZProject?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?          @relation("AiAgentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  model           String?
  systemPrompt    String?        @db.Text
  toolAllowlist   Json?
  config          Json?
  lastHeartbeatAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  conversations   AssistantConversation[]
  approvals       AssistantApproval[]
  aiJobs           ZAiJob[]

  @@index([projectId, kind, status])
  @@index([status, lastHeartbeatAt])
}

model ZProjectMember {
  id          String        @id @default(cuid())
  projectId   String
  userId      String
  preset      ZMemberPreset @default(VIEWER)
  permissions Json?
  active      Boolean       @default(true)
  joinedAt    DateTime      @default(now())
  leftAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     ZProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, active])
}

model ZOrganizationUnit {
  id        String              @id @default(cuid())
  projectId String
  parentId  String?
  code      String
  name      String
  type      ZUnitType           @default(DEPARTMENT)
  sortOrder Int                 @default(0)
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  project   ZProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ZOrganizationUnit?  @relation("ZOrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ZOrganizationUnit[] @relation("ZOrgTree")
  positions ZProjectPosition[]

  @@unique([projectId, code])
  @@index([projectId, active])
}

model ZProjectPosition {
  id          String               @id @default(cuid())
  projectId   String
  unitId      String?
  code        String
  title       String
  permissions Json?
  active      Boolean              @default(true)
  project     ZProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit        ZOrganizationUnit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignments ZProjectAssignment[]

  @@unique([projectId, code])
}

model ZProjectAssignment {
  id         String            @id @default(cuid())
  projectId  String
  userId     String
  positionId String
  status     ZAssignmentStatus @default(ACTIVE)
  startsAt   DateTime          @default(now())
  endsAt     DateTime?
  project    ZProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position   ZProjectPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([userId, status])
}

model ZWorkspaceConfigProposal {
  id             String                    @id @default(cuid())
  projectId      String
  moduleKey      String
  targetScope    String                    @default("PROJECT")
  status         ZWorkspaceProposalStatus  @default(DRAFT)
  riskLevel      String
  capability     String
  beforeConfig   Json?
  afterConfig    Json
  rollbackVersionId String?
  note           String?
  createdById    String
  approvedById   String?
  appliedById    String?
  approvedAt     DateTime?
  appliedAt      DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  project        ZProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User                      @relation("WorkspaceProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?                     @relation("WorkspaceProposalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  appliedBy      User?                     @relation("WorkspaceProposalApplier", fields: [appliedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([projectId, moduleKey, status])
}

model ZWorkspaceConfigVersion {
  id            String                 @id @default(cuid())
  projectId     String
  kind          ZWorkspaceConfigKind
  version       Int
  status        ZWorkspaceConfigStatus @default(DRAFT)
  config        Json
  note          String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdById   String
  approvedById  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  project       ZProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User                   @relation("WorkspaceConfigCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?                  @relation("WorkspaceConfigApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([projectId, kind, version])
  @@index([projectId, kind, status])
  @@index([projectId, effectiveFrom])
}

model ZWorkspaceCustomer {
  id          String   @id @default(cuid())
  projectId   String
  code        String
  fullName    String
  phoneLast4  String?
  source      String?
  note        String?
  consentStatus String?
  consentedAt DateTime?
  consentNote String?
  active      Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     ZProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("WorkspaceCustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy   User?    @relation("WorkspaceCustomerDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  appointments ZWorkspaceAppointment[]
  sales       ZWorkspaceSale[]

  @@unique([projectId, code])
  @@index([projectId, fullName])
  @@index([projectId, active])
  @@index([projectId, deletedAt])
}

model ZWorkspaceAppointment {
  id             String            @id @default(cuid())
  projectId      String
  customerId     String?
  scheduledAt    DateTime
  type           AppointmentType   @default(NEW)
  status         AppointmentStatus @default(BOOKED)
  serviceInterest String?
  note           String?
  assignedToId   String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        ZProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer       ZWorkspaceCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo     User?             @relation("WorkspaceAppointmentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User              @relation("WorkspaceAppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, scheduledAt])
  @@index([projectId, status])
  @@index([projectId, customerId])
}

model ZWorkspaceSale {
  id          String              @id @default(cuid())
  projectId   String
  customerId  String?
  code        String
  serviceName String
  amount      Decimal             @db.Decimal(14, 0)
  paidAmount  Decimal             @default(0) @db.Decimal(14, 0)
  status      ZWorkspaceSaleStatus @default(DRAFT)
  occurredAt  DateTime            @default(now())
  note        String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     ZProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer    ZWorkspaceCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy   User                @relation("WorkspaceSaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  ledgerEntries ZWorkspaceLedgerEntry[]
  paymentReconciliations ZWorkspacePaymentReconciliation[]

  @@unique([projectId, code])
  @@index([projectId, occurredAt])
  @@index([projectId, status])
}

model ZWorkspaceLedgerEntry {
  id            String                    @id @default(cuid())
  projectId     String
  saleId        String?
  code          String
  direction     ZWorkspaceLedgerDirection
  status        ZWorkspaceLedgerStatus     @default(POSTED)
  category      String
  description   String?
  amount        Decimal                   @db.Decimal(14, 0)
  occurredAt    DateTime                  @default(now())
  sourceRef     String?
  createdById   String
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  project       ZProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sale          ZWorkspaceSale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  reconciliationEntries ZWorkspacePaymentReconciliation[]
  createdBy     User                      @relation("WorkspaceLedgerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, code])
  @@index([projectId, direction, status, occurredAt])
  @@index([projectId, saleId])
}

model ZWorkspacePaymentReconciliation {
  id            String                       @id @default(cuid())
  projectId     String
  saleId        String?
  ledgerEntryId String?
  paymentRef    String
  amount        Decimal                      @db.Decimal(14, 0)
  status        ZWorkspaceReconciliationStatus @default(UNMATCHED)
  matchedAt     DateTime?
  matchedById   String?
  note          String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  project       ZProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sale          ZWorkspaceSale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  ledgerEntry   ZWorkspaceLedgerEntry?       @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  matchedBy     User?                        @relation("WorkspaceReconciliationMatcher", fields: [matchedById], references: [id], onDelete: SetNull)

  @@unique([projectId, paymentRef])
  @@index([projectId, status, createdAt])
  @@index([projectId, saleId])
  @@index([projectId, ledgerEntryId])
}

model ZWorkspacePayrollRun {
  id                  String                    @id @default(cuid())
  projectId           String
  mechanismVersionId  String?
  code                String
  periodStart         DateTime                  @db.Date
  periodEnd           DateTime                  @db.Date
  status              ZWorkspacePayrollRunStatus @default(DRAFT)
  currency            String                    @default("VND")
  mechanismSnapshot   Json?
  note                String?
  createdById         String
  approvedById        String?
  approvedAt          DateTime?
  secondApprovedById  String?
  secondApprovedAt    DateTime?
  finalizedById       String?
  finalizedAt         DateTime?
  voidedById          String?
  voidedAt            DateTime?
  voidReason          String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  project             ZProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mechanismVersion    ZMechanismVersion?        @relation(fields: [mechanismVersionId], references: [id], onDelete: SetNull)
  createdBy           User                      @relation("WorkspacePayrollRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy          User?                     @relation("WorkspacePayrollRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  secondApprovedBy    User?                     @relation("WorkspacePayrollRunSecondApprover", fields: [secondApprovedById], references: [id], onDelete: SetNull)
  finalizedBy         User?                     @relation("WorkspacePayrollRunFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  voidedBy            User?                     @relation("WorkspacePayrollRunVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  lines               ZWorkspacePayrollLine[]

  @@unique([projectId, code])
  @@index([projectId, status, periodStart, periodEnd])
  @@index([projectId, mechanismVersionId])
}

model ZWorkspacePayrollLine {
  id              String                       @id @default(cuid())
  runId           String
  projectId       String
  userId          String
  status          ZWorkspacePayrollLineStatus @default(CALCULATED)
  grossAmount     Decimal                      @db.Decimal(14, 0)
  commissionAmount Decimal                     @db.Decimal(14, 0)
  deductionAmount Decimal                      @default(0) @db.Decimal(14, 0)
  netAmount       Decimal                      @db.Decimal(14, 0)
  snapshot        Json
  note            String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  run             ZWorkspacePayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  project         ZProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User                         @relation("WorkspacePayrollLineUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([runId, userId])
  @@index([projectId, status])
  @@index([projectId, userId])
}

model ZWorkspaceTask {
  id          String                    @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      PlanTaskStatus            @default(TODO)
  priority    ZWorkspaceTaskPriority    @default(NORMAL)
  dueAt       DateTime?
  order       Int                       @default(0)
  assigneeId  String?
  createdById String
  completedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  project     ZProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?                     @relation("WorkspaceTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User                      @relation("WorkspaceTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, status, order])
  @@index([projectId, dueAt])
  @@index([projectId, assigneeId])
}

model ZMechanismDefinition {
  id          String              @id @default(cuid())
  projectId   String
  code        String
  name        String
  kind        ZMechanismKind
  description String?
  status      ZMechanismStatus    @default(DRAFT)
  project     ZProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    ZMechanismVersion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([projectId, code])
  @@index([projectId, status])
}

model ZMechanismVersion {
  id            String               @id @default(cuid())
  definitionId  String
  version       Int
  status        ZMechanismStatus     @default(DRAFT)
  inputSchema   Json
  ruleSpec      Json
  testCases     Json?
  assumptions   Json?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  definition    ZMechanismDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  payrollRuns   ZWorkspacePayrollRun[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([definitionId, version])
  @@index([definitionId, status])
}


// ============================ AI TRAINING STUDIO V3 ============================

enum ZAgentProfileStatus {
  DRAFT
  TESTING
  PUBLISHED
  RETIRED
}

enum ZTrainingExampleKind {
  KNOWLEDGE
  CLARIFICATION
  TOOL_CHOICE
  WARNING
  REFUSAL
  POLICY
}

enum ZTrainingRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
}

model ZAgentProfile {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  description    String?
  status         ZAgentProfileStatus @default(DRAFT)
  model          String?
  systemPrompt   String?
  capabilities   Json?
  policyConfig   Json?
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  datasets       ZTrainingDataset[]
  prompts        ZPromptVersion[]
  evaluations    ZEvaluationRun[]
}

model ZTrainingDataset {
  id          String               @id @default(cuid())
  agentId     String
  code        String
  name        String
  description String?
  kind        ZTrainingExampleKind  @default(KNOWLEDGE)
  version     Int                  @default(1)
  active      Boolean              @default(false)
  agent       ZAgentProfile        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  examples    ZTrainingExample[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([agentId, code, version])
  @@index([agentId, active])
}

model ZTrainingExample {
  id          String             @id @default(cuid())
  datasetId   String
  input       Json
  expected    Json
  tags        Json?
  approved    Boolean            @default(false)
  dataset     ZTrainingDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([datasetId, approved])
}

model ZPromptVersion {
  id          String        @id @default(cuid())
  agentId     String
  version     Int
  name        String
  template    String
  variables   Json?
  status      ZAgentProfileStatus @default(DRAFT)
  agent       ZAgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([agentId, version])
}

model ZEvaluationRun {
  id          String             @id @default(cuid())
  agentId     String
  datasetId   String?
  status      ZTrainingRunStatus @default(QUEUED)
  score       Decimal?           @db.Decimal(5, 2)
  metrics     Json?
  report      Json?
  agent       ZAgentProfile      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  completedAt DateTime?

  @@index([agentId, status])
}
