# Trung tâm Phẫu thuật Tạo hình Thẩm mỹ — BVĐK Hồng Phúc
# Kho mã: app web (web/) + script triển khai (windows/) + app máy con (client/).

# Biến môi trường / khoá bí mật — KHÔNG đưa lên Git
.env
.env.*
!.env.example
.runtime/
PHONE_ENC_KEY*.txt

# Phụ thuộc & build (web/ có .gitignore riêng cho Next.js)
node_modules/
dist/
build/
*.log

# Artifact QA/runtime cục bộ — không phải mã nguồn, thường chứa profile/cache hoặc HTML test.
checks/qa-*
checks/release-verification-*.txt

# Hệ điều hành / trình soạn thảo
.DS_Store
Thumbs.db
.vscode/
.idea/

# Git worktree / checkout phụ nằm bên trong repo chính — đây là repo Git RIÊNG
# (có .git của chính nó), tuyệt đối không được `git add` thành gitlink của repo
# này (không có .gitmodules → ai clone sẽ nhận thư mục rỗng). Nếu cần track,
# phải làm submodule thật có chủ đích, không phải add nhầm.
worktrees/
_qa-latest-candidate/
