# Cấu hình tuỳ chọn cho docker-compose.yml (đặt cạnh file này, đổi tên thành .env).
# KHÔNG bắt buộc: nếu để trống, hệ thống tự sinh AUTH_SECRET an toàn trong volume.
#
# ⚠️ KHÔNG đưa file .env (đã điền khoá thật) lên Git/GitHub.

# Khoá ký phiên đăng nhập. Tạo khoá mạnh:  openssl rand -base64 48
# Đổi khoá này chỉ khiến mọi người đăng nhập lại — an toàn.
AUTH_SECRET=

# Khoá mã hoá số điện thoại (base64 của 32 byte).  openssl rand -base64 32
# ⚠️ Đổi khoá này sẽ làm KHÔNG đọc được SĐT đã lưu — cần mã hoá lại dữ liệu.
PHONE_ENC_KEY=
UPLOAD_DIR=/app/private/uploads

# Tạo tài khoản quản trị lần đầu khi CSDL còn trống (không dùng mật khẩu demo).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Chỉ bật nếu deployment đứng sau proxy đã được tin cậy (Cloudflare/Caddy).
TRUSTED_PROXY=false
# Chỉ dùng môi trường QA với dữ liệu giả; tuyệt đối không bật production.
ALLOW_DEMO_SEED=false

# Mật khẩu cơ sở dữ liệu PostgreSQL (đổi trước khi chạy thật).
POSTGRES_PASSWORD=zenith_dev_pw

# Khi chạy qua tên miền/Cloudflare Tunnel: liệt kê tên miền, ngăn cách bằng dấu phẩy.
APP_ORIGINS=

# AI soạn tin chăm sóc khách (Claude của Anthropic). Tạo key ở console.anthropic.com.
# Để trống = tính năng AI tự ẩn. (Tuỳ chọn) đổi mô hình qua ANTHROPIC_MODEL.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Kênh giao tiếp: Zalo OA + Facebook Messenger (TUỲ CHỌN — để trống thì trang
# /cham-soc/hop-thu vẫn chạy nhưng không nhận/gửi tin thật). Hướng dẫn lấy từng
# giá trị bên dưới có ngay trong app: /cham-soc/ket-noi (đăng nhập ADMIN).
# Zalo OA (PHẢI là Official Account đăng ký tại oa.zalo.me — Zalo cá nhân KHÔNG
# có API chính thức):
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
# Facebook Messenger (Fanpage):
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_APP_ID=
FB_GRAPH_API_VERSION=
