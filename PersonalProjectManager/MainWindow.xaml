<Window x:Class="PersonalProjectManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonalProjectManager"
        xmlns:vm="clr-namespace:PersonalProjectManager.ViewModels"
        mc:Ignorable="d"
        Title="Personal Project Manager" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightGrayBrush}" /* Màu nền tổng thể sáng hơn */
        FontFamily="{StaticResource BaseFontFamily}"
        FontSize="{StaticResource BaseFontSize}"
        Foreground="{StaticResource TextPrimaryBrush}"
        MinWidth="1024" MinHeight="600">

<Window.Resources>
    <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource NavigationForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Command" Value="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator"
                                        Grid.Column="0"
                                        Background="{StaticResource PrimaryBrush}"
                                        Width="4" Height="24" CornerRadius="2"
                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Margin="-15,0,0,0" /* Dịch ra ngoài padding */
                                        Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                                  ContentSource="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavigationHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavigationSelectedBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

</Window.Resources>

<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="220"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource NavigationBackgroundBrush}"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="20,25,20,35" HorizontalAlignment="Left">
                <TextBlock Text="📊" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Project Manager" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,10">
                <StackPanel>
                    <RadioButton Style="{StaticResource NavigationButtonStyle}" Tag="Dashboard" IsChecked="True" GroupName="NavGroup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text=""/>
                            <TextBlock Text="Tổng quan"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavigationButtonStyle}" Tag="ProgressDashboard" GroupName="NavGroup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text=""/>
                            <TextBlock Text="Tiến độ Dự án"/>
                        </StackPanel>
                    </RadioButton>

                    <Separator Margin="15,10" Background="#55FFFFFF"/>

                    <RadioButton Style="{StaticResource NavigationButtonStyle}" Tag="ProjectList" GroupName="NavGroup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text=""/>
                            <TextBlock Text="Dự án Đang làm"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavigationButtonStyle}" Tag="CompletedProjectList" GroupName="NavGroup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text=""/>
                            <TextBlock Text="Dự án Đã xong"/>
                        </StackPanel>
                    </RadioButton>

                    <Separator Margin="15,10" Background="#55FFFFFF"/>

                    <RadioButton Style="{StaticResource NavigationButtonStyle}" Tag="CreateProject" GroupName="NavGroup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text=""/>
                            <TextBlock Text="Tạo Dự án mới"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}" Padding="20">
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <Storyboard x:Key="FadeInStory">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </ContentControl.Resources>
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{Binding Content, RelativeSource={RelativeSource Self}}">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeInStory}"/>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Border>

</Grid>
</Window>