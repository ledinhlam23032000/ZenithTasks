<UserControl x:Class="PersonalProjectManager.Views.ProjectListView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:PersonalProjectManager.Views"
                 xmlns:vm="clr-namespace:PersonalProjectManager.ViewModels"
                 xmlns:models="clr-namespace:PersonalProjectManager.Models"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:converters="clr-namespace:PersonalProjectManager.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ProjectListViewModel, IsDesignTimeCreatable=False}"
                 Background="White"
                 d:DesignHeight="600" d:DesignWidth="750">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Dự Án Đang Triển Khai" Style="{StaticResource HeaderTextStyle}" VerticalAlignment="Center"/>
            <Button Content="Làm Mới" Command="{Binding RefreshProjectsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Tải lại danh sách dự án."/>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="{StaticResource RowBackgroundBrush}">

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding ViewProjectDetailCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên Dự Án" Binding="{Binding ProjectName}" Width="3*"/>
                    <DataGridTextColumn Header="Người Thực Hiện" Binding="{Binding Owner}" Width="2*"/>
                    <DataGridTextColumn Header="Ngày Bắt Đầu" Binding="{Binding StartDate, StringFormat='dd/MM/yyyy'}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ngày Kết Thúc" Binding="{Binding EndDate, StringFormat='dd/MM/yyyy'}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding InfoMessage}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="0,10,0,0" FontStyle="Italic" HorizontalAlignment="Center"
                        Visibility="{Binding InfoMessage, Converter={StaticResource NullToVisibilityConverter}}"/>


        <Border Grid.Row="0" Grid.RowSpan="3" Background="#AAFFFFFF" CornerRadius="4"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Đang tải danh sách dự án..." FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <ProgressBar IsIndeterminate="True" Height="10" Width="200" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
    