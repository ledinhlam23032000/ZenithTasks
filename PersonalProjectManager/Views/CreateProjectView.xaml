<UserControl x:Class="PersonalProjectManager.Views.CreateProjectView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:PersonalProjectManager.Views"
                 xmlns:vm="clr-namespace:PersonalProjectManager.ViewModels"
                 xmlns:converters="clr-namespace:PersonalProjectManager.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:CreateProjectViewModel, IsDesignTimeCreatable=False}"
                 Background="White"
                 d:DesignHeight="600" d:DesignWidth="700">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tạo Dự Án Mới" Style="{StaticResource HeaderTextStyle}"/>

        <Border Grid.Row="1" Background="{StaticResource LightGrayBrush}" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên dự án (*):" Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                             Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tên dự án là bắt buộc."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Người thực hiện:" Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="Mục tiêu chính:" Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="4"
                             Text="{Binding ProjectGoal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Mô tả ngắn gọn mục tiêu tổng thể của dự án."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ngày bắt đầu:" Style="{StaticResource LabelTextStyle}"/>
                <DatePicker Grid.Row="2" Grid.Column="1"
                                SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="Ngày kết thúc:" Style="{StaticResource LabelTextStyle}"/>
                <DatePicker Grid.Row="2" Grid.Column="4"
                                SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tài nguyên:" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Top" Margin="0,3,8,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                             Text="{Binding Resources, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto"
                             ToolTip="Nhập link, đường dẫn file hoặc ghi chú tài nguyên liên quan."/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Xóa Form" Command="{Binding ClearFormCommand}" Background="OrangeRed" ToolTip="Xóa các thông tin đã nhập trên form."/>
            <Button Content="Lưu Dự Án" Command="{Binding SaveProjectCommand}" ToolTip="Lưu dự án mới vào cơ sở dữ liệu."/>
            <ProgressBar IsIndeterminate="True" Height="15" Width="100" Margin="10,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" FontWeight="SemiBold"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSuccessMessage}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </Grid>
</UserControl>
    