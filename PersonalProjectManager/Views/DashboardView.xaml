<UserControl x:Class="PersonalProjectManager.Views.DashboardView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:PersonalProjectManager.Views"
                 xmlns:vm="clr-namespace:PersonalProjectManager.ViewModels"
                 xmlns:converters="clr-namespace:PersonalProjectManager.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel, IsDesignTimeCreatable=False}"
                 Background="#FFEFEFEF"
                 d:DesignHeight="700" d:DesignWidth="850">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,10,10,25">
            <TextBlock Text="{Binding WelcomeMessage}" FontSize="28" FontWeight="Light" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
            <Button Command="{Binding RefreshDashboardCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Style="{StaticResource NavButtonStyle}" Background="Gray" Padding="12,6" ToolTip="Làm mới dữ liệu Dashboard">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Làm mới" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="5,0,5,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding ViewActiveProjectsCommand}" Margin="5" Cursor="Hand"
                         ToolTip="Nhấn để xem danh sách dự án đang triển khai" Style="{x:Null}" VerticalAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" CornerRadius="6" Padding="25,20" BorderBrush="#DDD" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📊 Đang triển khai" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ActiveProjectCount}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="dự án" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="1" Command="{Binding ViewCompletedProjectsCommand}" Margin="5" Cursor="Hand"
                         ToolTip="Nhấn để xem danh sách dự án đã hoàn thành" Style="{x:Null}" VerticalAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" CornerRadius="6" Padding="25,20" BorderBrush="#DDD" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="✅ Đã hoàn thành" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding CompletedProjectCount}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="dự án" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="25,20" BorderBrush="#DDD" BorderThickness="1" Margin="5" VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel Opacity="0.6">
                    <TextBlock Text="❗ Sắp hết hạn" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="0" FontSize="42" FontWeight="Bold" Foreground="OrangeRed"/>
                    <TextBlock Text="nhiệm vụ (sắp có)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,20">
            <Button Content="➕ Tạo Dự Án Mới"
                          Command="{Binding CreateNewProjectCommand}"
                          ToolTip="Bắt đầu một dự án mới."
                          Padding="20,10" FontSize="14" FontWeight="SemiBold"/>

            <Button Content=" Xem Tổng Quan Tiến Độ" Margin="15,5,5,5"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="ProgressDashboard"
                          ToolTip="Xem biểu đồ hoặc danh sách tiến độ tổng hợp."
                          Style="{StaticResource NavButtonStyle}"/>

            <Button Content=" Xem Dự Án Hoàn Thành" Margin="5"
                         Command="{Binding ViewCompletedProjectsCommand}"
                         ToolTip="Xem lại các dự án đã hoàn thành."
                         Style="{StaticResource NavButtonStyle}"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Hoạt động gần đây" Margin="0,0,10,0" Padding="15" FontWeight="SemiBold">
                <TextBlock Text="Tính năng đang phát triển..." Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </GroupBox>
            <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="20" Margin="10,0,0,0" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💡 Mẹo sử dụng" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="• Nhấn vào các thẻ thống kê ở trên để xem nhanh danh sách dự án." TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="• Double-click vào dự án trong danh sách hoặc dashboard tiến độ để xem chi tiết." TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="• Sử dụng menu bên trái để truy cập tất cả các chức năng." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="4" Background="#DDFFFFFF" CornerRadius="5"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Đang tải dữ liệu Dashboard..." FontSize="16" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <ProgressBar IsIndeterminate="True" Height="10" Width="200" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
    